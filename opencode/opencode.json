{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "default_agent": "plan",
  "model": "opencode/big-pickle",
  "small_model": "openrouter/openrouter/free",
  "provider": {
    "openrouter": {
      "models": {
        "openrouter/free": {}
      }
    }
  },
  "agent": {
    "plan": { "color": "#FFD700" },
    "build": { "color": "#FF5733" }
  },
  "permission": {
    "read": "allow",
    "bash": {
      "git commit*": "ask",
      "git push*": "ask",
      "pip*": "ask",
      "npm*": "ask",
      "brew*": "ask"
    }
  }
}
